__MWOPC_PART_BEGIN__ /simulink/stateflow/chart_200.xml
<?xml version="1.0" encoding="utf-8"?>
<chart id="200">
  <P Name="name">Plant1/MATLAB Function2</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">200</P>
  <subviewS/>
  <P Name="ssIdHighWaterMark">9</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">28</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">Ground_Contact</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">200</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [F_c, M_c] = Ground_Contact(p_cm, q, v_b, w_b)
    
    % Force inputs to be column vectors to prevent [1x1] Coder mismatches
    p_cm = p_cm(:); 
    q = q(:); 
    v_b = v_b(:); 
    w_b = w_b(:);

    % Initialize output accumulators
    F_c = [0; 0; 0];
    M_c = [0; 0; 0];
    
    % Constants from Section II-C 
    m = 0.21;
    k_p = 100; % Spring constant 
    k_v = 5;   % Damper constant 
    
    % Build the Rotation Matrix R_q safely without toolbox functions
    q0 = q(1); q1 = q(2); q2 = q(3); q3 = q(4);
    R_q = [1 - 2*(q2^2 + q3^2),   2*(q1*q2 - q0*q3),   2*(q0*q2 + q1*q3);
           2*(q1*q2 + q0*q3),   1 - 2*(q1^2 + q3^2),   2*(q2*q3 - q0*q1);
           2*(q1*q3 - q0*q2),   2*(q0*q1 + q2*q3),   1 - 2*(q1^2 + q2^2)];
    
    % ====================================================================
    % 1. DEFINE CONTACT POINTS r_k (Required for Simulink Coder)
    % ====================================================================
    % r_k is a 3x13 matrix defining the physical boundaries of the drone
    % [X; Y; Z] locations relative to the Center of Mass in meters.
    r_k = zeros(3, 13);
    
    r_k(:,1) = [-0.15;  0.0;  0.0]; % Tail center (Landing point)
    r_k(:,2) = [-0.15;  0.2;  0.0]; % Tail right
    r_k(:,3) = [-0.15; -0.2;  0.0]; % Tail left
    r_k(:,4) = [-0.15;  0.0;  0.2]; % Tail top
    r_k(:,5) = [-0.15;  0.0; -0.2]; % Tail bottom
    r_k(:,6) = [ 0.0;   0.3;  0.0]; % Wing tip right
    r_k(:,7) = [ 0.0;  -0.3;  0.0]; % Wing tip left
    r_k(:,8) = [ 0.1;   0.15; 0.1]; % Prop guard Top-Right
    r_k(:,9) = [ 0.1;  -0.15; 0.1]; % Prop guard Top-Left
    r_k(:,10)= [ 0.1;   0.15;-0.1]; % Prop guard Bottom-Right
    r_k(:,11)= [ 0.1;  -0.15;-0.1]; % Prop guard Bottom-Left
    r_k(:,12)= [ 0.15;  0.0;  0.0]; % Nose
    r_k(:,13)= [ 0.0;   0.0;  0.0]; % Core Center
    % ====================================================================
    
    num_points = 13;
    
    for k = 1:num_points
        % Extract vector explicitly to keep Coder happy
        r_k_vec = [r_k(1,k); r_k(2,k); r_k(3,k)]; 
        
        % 1. Where is this specific point in the real world?
        p_I_k = p_cm + R_q * r_k_vec;
        
        % Check for floor penetration (Z &gt; 0)
        d_k = p_I_k(3); 
        
        if d_k &gt; 0
            % 2. How fast did it hit? 
            v_I_k = R_q * (v_b + cross(w_b, r_k_vec));
            
            % 3. Calculate Reaction Force
            % Pre-allocate F_I_k with zeros to prevent Coder indexing errors
            F_I_k = zeros(3, 1); 
            F_I_k = [0; 0; -m * k_p * d_k] - (m * k_v * v_I_k);
            
            % The ground can only push UP (negative Z), it cannot pull DOWN
            if F_I_k(3) &gt; 0
                F_I_k(3) = 0; 
            end
            
            % 4. Translate the Inertial Force back to the Body Frame
            F_body = R_q&apos; * F_I_k;
            
            % 5. Add to totals
            F_c = F_c + F_body;
            M_c = M_c + cross(r_k_vec, F_body);
        end
    end
end</P>
      </eml>
    </state>
    <data SSID="4" name="p_cm">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="5" name="F_c">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="6" name="q">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="7" name="v_b">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="8" name="w_b">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="9" name="M_c">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <transition SSID="2">
      <P Name="labelString">{eML_blk_kernel();}</P>
      <P Name="labelPosition">[28.125 13.875 102.544 14.964]</P>
      <P Name="fontSize">12</P>
      <src>
        <P Name="intersection">[0 0 1 0 23.5747 14.625 0 0]</P>
      </src>
      <dst>
        <P Name="SSID">3</P>
        <P Name="intersection">[1 0 -1 0 23.5747 42.5747 0 0]</P>
      </dst>
      <P Name="midPoint">[23.5747 24.9468]</P>
      <P Name="dataLimits">[21.175 25.975 14.625 42.575]</P>
      <P Name="subviewer">200</P>
      <P Name="drawStyle">SMART</P>
      <slide>
        <P Name="sticky">BOTH_STICK</P>
      </slide>
      <P Name="executionOrder">1</P>
    </transition>
    <junction SSID="3">
      <P Name="position">[23.5747 49.5747 7]</P>
      <P Name="subviewer">200</P>
      <P Name="type">CONNECTIVE_JUNCTION</P>
    </junction>
  </Children>
</chart>

__MWOPC_PART_BEGIN__ /simulink/stateflow/chart_211.xml
<?xml version="1.0" encoding="utf-8"?>
<chart id="211">
  <P Name="name">Plant1/Thruster_dynamics</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">211</P>
  <subviewS/>
  <P Name="ssIdHighWaterMark">12</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">29</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">fcn</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">211</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [T_vec, F_t, M_t] = fcn(v_b, w_b, tau, V_batt,v_w)
    r_p = 0.0625;
    l = 0.145;        % Lateral position of thruster [m]
    rho = 1.225;      % Air density [kg/m^3]
    I_th = 1.6e-6;    % Thruster Rotational Inertia [kg m^2]
    
    u_rel = v_b(1)-v_w(1);
    r = w_b(3);
    
    v_in_l = u_rel + r*l;
    v_in_r = u_rel - r*l;
    
    % Propeller angular speeds
    w_b_l = (V_batt^0.8) * (-84.75*tau(1)^2 + 356.34*tau(1) - 4.27);
    w_b_r = (V_batt^0.8) * (-84.75*tau(2)^2 + 356.34*tau(2) - 4.27);
    
    % Advance ratios
    J_l = (pi * v_in_l) / (w_b_l * r_p);
    J_r = (pi * v_in_r) / (w_b_r * r_p);
    
    % Bound J at 0 for static coefficients
    J_l_calc = max(0, J_l);
    J_r_calc = max(0, J_r);
    
    % Thrust and Power Coefficients
    CT_l = -0.1281*J_l_calc^2 - 0.1196*J_l_calc + 0.1342;
    CT_r = -0.1281*J_r_calc^2 - 0.1196*J_r_calc + 0.1342;
    
    CP_l = -0.0602*J_l_calc^2 - 0.0146*J_l_calc + 0.0522;
    CP_r = -0.0602*J_r_calc^2 - 0.0146*J_r_calc + 0.0522;
    
    % Forces and Torques
    T_l = (4 / pi^2) * rho * r_p^4 * w_b_l^2 * CT_l;
    T_r = (4 / pi^2) * rho * r_p^4 * w_b_r^2 * CT_r;
    T_vec = [T_l; T_r];
        
    % Fixed the variable names here to w_b_l and w_b_r
    Q_l = (4 / pi^3) * rho * r_p^5 * w_b_l^2 * CP_l;
    Q_r = (4 / pi^3) * rho * r_p^5 * w_b_r^2 * CP_r;
    Q_vec = [Q_l; Q_r];
    
    % Total forces and moments mapped to body frame
    F_t = [T_l + T_r; 0; 0];
        
    gyro_moment = I_th * (w_b_l - w_b_r) * [0; -w_b(3); w_b(2)];
    M_t = [Q_r - Q_l; 0; l*(T_l - T_r)] + gyro_moment;
end</P>
      </eml>
    </state>
    <data SSID="6" name="v_b">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="4" name="w_b">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="5" name="T_vec">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="7" name="tau">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="8" name="V_batt">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="9" name="F_t">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="10" name="M_t">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="12" name="v_w">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <transition SSID="2">
      <P Name="labelString">{eML_blk_kernel();}</P>
      <P Name="labelPosition">[28.125 13.875 102.544 14.964]</P>
      <P Name="fontSize">12</P>
      <src>
        <P Name="intersection">[0 0 1 0 23.5747 14.625 0 0]</P>
      </src>
      <dst>
        <P Name="SSID">3</P>
        <P Name="intersection">[1 0 -1 0 23.5747 42.5747 0 0]</P>
      </dst>
      <P Name="midPoint">[23.5747 24.9468]</P>
      <P Name="dataLimits">[21.175 25.975 14.625 42.575]</P>
      <P Name="subviewer">211</P>
      <P Name="drawStyle">SMART</P>
