__MWOPC_PART_BEGIN__ /simulink/stateflow/chart_49.xml
<?xml version="1.0" encoding="utf-8"?>
<chart id="49">
  <P Name="name">Controller1/MATLAB Function</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">49</P>
  <subviewS/>
  <P Name="ssIdHighWaterMark">11</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">15</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">actuator_mixer</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">49</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [tau, delta] = actuator_mixer(F_d, v_b, omega_b, V_batt, M_d, landing_flag)

    %% --- INPUTS ---
    F_d_in = F_d(1);
    u1     = v_b(1);
    w1     = v_b(3);
    r      = omega_b(3);
    V_b    = V_batt(1);

    L_d       = M_d(1);
    M_d_pitch = M_d(2);
    N_d       = M_d(3);

    %% --- CONSTANTS (Table I &amp; II) ---
    l       = 0.145;
    rho     = 1.225;
    r_p     = 0.0625;
    v_s_min = 8.0;
    delta_max = 39 * (pi/180);

    c_x = 9.91e-4;
    c_y = 4.74e-4;
    b_x = 9.37e-4;
    b_y = 3.48e-4;

    S      = 0.08;
    c_bar  = 0.17;
    m      = 0.21;
    g      = 9.81;

    %% --- STEP 1: INFLOW VELOCITIES (Eq. 12 context) ---
    v_in_l = u1 + r * l;
    v_in_r = u1 - r * l;

    if landing_flag == 1
        tau = [0; 0];
        delta = [0; 0];
   
    else

    %% --- STEP 2: F_MAX CAP — 95% of max thrust (Eq. 48) ---
        omega_max = (V_b^0.8) * (-84.75*(1.0)^2 + 356.34*(1.0) - 4.27);
        omega_max = max(0, omega_max);
    
        % Use J=0 static CT for max thrust estimate (most conservative)
        % At full throttle, v_in may not be zero — use actual inflow
        J_max_l = (pi * v_in_l) / (omega_max * r_p + 1e-6);
        CT_max  = max(0, -0.1281*J_max_l^2 - 0.1196*J_max_l + 0.1342);
        T_max   = (4 / pi^2) * rho * r_p^4 * omega_max^2 * CT_max;
        F_max   = 2 * 0.95 * T_max;
    
        % Clamp desired force
        F_d_in = min(F_d_in, F_max);
        F_d_in = max(0, F_d_in);
    
        %% --- STEP 3: SOLVE FOR LEFT/RIGHT THRUST (Eq. 49) ---
        T_l = 0.5 * F_d_in + (1 / (2*l)) * N_d;
        T_r = 0.5 * F_d_in - (1 / (2*l)) * N_d;
    
        %% --- STEP 4: T_MIN — minimum slipstream (Eq. 50) ---
        % Use total XZ velocity magnitude (matches Eq. 26 context)
        V_xz_sq = u1^2;
        T_min   = 0.5 * rho * pi * r_p^2 *(v_s_min^2 - V_xz_sq);
    
        T_l = max(T_l, T_min);
        T_r = max(T_r, T_min);
    
        %% --- STEP 5: INVERT THRUSTER MODEL ---
        [tau_l, omega_l, Q_l] = invert_thruster(T_l, v_in_l, V_b, rho, r_p);
        [tau_r, omega_r, Q_r] = invert_thruster(T_r, v_in_r, V_b, rho, r_p);
        tau = [tau_l; tau_r];
    
        %% --- STEP 6: NATURAL PITCHING MOMENT M_0 (Eq. 28) ---
        alpha = atan2(w1, u1);
    
        % 7th order polynomial fit of CM(alpha) curve from Fig. 5
        % Fitted in radians over range [-pi, pi]
        p_CM = [-0.0013, 0, 0.0521, 0, -0.3185, 0, 0.4233, 0];
        C_M  = polyval(p_CM, alpha);
    
        M_0 = 0.5 * rho * V_xz_sq * S * c_bar * C_M;
    
        %% --- STEP 7: BUILD MATRIX A (Eq. 52) ---
        P_d = 0.5 * rho * V_xz_sq;
        den = pi * r_p^2;
    
        A11 =  (c_x / den) * T_l + P_d * b_x;
        A12 = -(c_x / den) * T_r - P_d * b_x;
        A21 = -(c_y / den) * T_l - P_d * (c_y + b_y);
        A22 = -(c_y / den) * T_r - P_d * (c_y + b_y);
    
        A_mat = [A11, A12;
                 A21, A22];
    
        %% --- STEP 8: SOLVE FOR DEFLECTIONS (Eq. 51) ---
        b_vec = [L_d - (Q_r - Q_l);
                 M_d_pitch - M_0];
    
        % Check if A is invertible
        if abs(det(A_mat)) &lt; 1e-10
            % Fallback: zero deflection — slipstream too low
            delta = [0; 0];
        else
            delta = A_mat \ b_vec;
        end
    
        %% --- STEP 9: PITCHING MOMENT BOOST (Eq. 53) ---
        % If mean deflection is non-zero, the mixer needs more slipstream
        delta_bar = 0.5 * (delta(1) + delta(2));
    
        if abs(delta_bar) &gt; 0.01
            denom_boost = -(c_y / den) * delta_bar;
    
            if abs(denom_boost) &gt; 1e-6
                F_d_boost = (M_d_pitch - M_0 + 2*P_d*(c_y + b_y)*delta_bar) ...
                            / denom_boost;
                F_d_boost = max(0, min(F_max, F_d_boost));
    
                % Only boost — never reduce thrust here
                if F_d_boost &gt; F_d_in
                    F_d_in = F_d_boost;
    
                    % Recompute thrust split
                    T_l = max(0.5*F_d_in + (1/(2*l))*N_d, T_min);
                    T_r = max(0.5*F_d_in - (1/(2*l))*N_d, T_min);
    
                    % Recompute thrusters
                    [tau_l, omega_l, Q_l] = invert_thruster(T_l, v_in_l, V_b, rho, r_p);
                    [tau_r, omega_r, Q_r] = invert_thruster(T_r, v_in_r, V_b, rho, r_p);
                    tau = [tau_l; tau_r];
    
                    % Rebuild A with new thrusts
                    A11 =  (c_x/den)*T_l + P_d*b_x;
                    A12 = -(c_x/den)*T_r - P_d*b_x;
                    A21 = -(c_y/den)*T_l - P_d*(c_y+b_y);
                    A22 = -(c_y/den)*T_r - P_d*(c_y+b_y);
                    A_mat = [A11,A12; A21,A22];
    
                    % Recompute b_vec and solve
                    b_vec = [L_d - (Q_r - Q_l);
                             M_d_pitch - M_0];
    
                    if abs(det(A_mat)) &gt; 1e-10
                        delta = A_mat \ b_vec;
                    end
                end
            end
        end
    
        %% --- STEP 10: CLAMP DEFLECTIONS ---
        delta(1) = max(-delta_max, min(delta_max, delta(1)));
        delta(2) = max(-delta_max, min(delta_max, delta(2)));
    end
end


function [tau, omega, Q] = invert_thruster(T_des, v_in, V_b, rho, r_p)

    % Propeller polynomial coefficients (Eq. 38)
    ct2 = -0.1281;  ct1 = -0.1196;  ct0 = 0.1342;
    cp2 = -0.0602;  cp1 = -0.0146;  cp0 = 0.0522;

    %% STEP A: Solve for omega from desired thrust T
    % T = K_T * [ct0*w^2 + ct1*(pi*v_in/r_p)*w + ct2*(pi*v_in/r_p)^2]
    K_T = (4 / pi^2) * rho * r_p^4;
    v_norm = (pi * v_in) / r_p;   % shorthand

    A_w =  K_T * ct0;
    B_w =  K_T * ct1 * v_norm;
    C_w =  K_T * ct2 * v_norm^2 - T_des;

    discriminant_w = B_w^2 - 4*A_w*C_w;

    if discriminant_w &lt; 0 || A_w &lt; 1e-12
        % Cannot achieve thrust — use max omega
        omega = (V_b^0.8) * (-84.75 + 356.34 - 4.27);
        omega = max(0, omega);
    else
        omega1 = (-B_w + sqrt(discriminant_w)) / (2*A_w);
        omega2 = (-B_w - sqrt(discriminant_w)) / (2*A_w);

        % Pick smallest positive root (physical solution)
        candidates = [omega1, omega2];
        candidates = candidates(candidates &gt; 0);

        if isempty(candidates)
            omega = 0;
        else
            omega = min(candidates);
        end
    end

    omega = max(0, omega);

    %% STEP B: Compute torque Q from omega (Eq. 10 expanded)
    K_Q = (4 / pi^3) * rho * r_p^5;
    Q = K_Q * (cp0*omega^2 + cp1*v_norm*omega + cp2*v_norm^2);
    % Note: no clamping — Q can be small/negative in descent regime

    %% STEP C: Solve for tau from omega (Eq. 36 inverted)
    % omega = V_b^0.8 * (-84.75*tau^2 + 356.34*tau - 4.27)
    % Rearranged: -84.75*tau^2 + 356.34*tau - 4.27 - omega/V_b^0.8 = 0

    Vb_08 = V_b^0.8 + 1e-9;
    a_q =  -84.75;
    b_q =  356.34;
    c_q =  -4.27 - (omega / Vb_08);

    discriminant_tau = b_q^2 - 4*a_q*c_q;

    if discriminant_tau &lt; 0
        tau = 1.0;  % saturate
    else
        tau1 = (-b_q + sqrt(discriminant_tau)) / (2*a_q);
        tau2 = (-b_q - sqrt(discriminant_tau)) / (2*a_q);

        % Clamp both to [0,1]
        tau1 = max(0, min(1, tau1));
        tau2 = max(0, min(1, tau2));

        % Pick the one that best reproduces the required omega
        omega_check1 = Vb_08 * (-84.75*tau1^2 + 356.34*tau1 - 4.27);
        omega_check2 = Vb_08 * (-84.75*tau2^2 + 356.34*tau2 - 4.27);

        if abs(omega_check1 - omega) &lt;= abs(omega_check2 - omega)
            tau = tau1;
        else
            tau = tau2;
        end
    end

end</P>
      </eml>
    </state>
    <data SSID="6" name="F_d">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
