<?xml version="1.0" encoding="utf-8"?>
<chart id="98">
  <P Name="name">Controller1/M_G</P>
  <P Name="windowPosition">[-1 -7 1538 824]</P>
  <P Name="viewLimits">[182.953 1628.553 11.629 598.029]</P>
  <P Name="zoomFactor">1.333</P>
  <P Name="screen">[1 1 3200 1200 1.25]</P>
  <P Name="viewObj">98</P>
  <subviewS/>
  <P Name="ssIdHighWaterMark">39</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="chartFileNumber">20</P>
  <P Name="allowGlobalAccessToExportedFunctions">0</P>
  <P Name="saturateOnIntegerOverflow">1</P>
  <P Name="userSpecifiedStateTransitionExecutionOrder">1</P>
  <P Name="disableImplicitCasting">1</P>
  <P Name="actionLanguage">2</P>
  <Children>
    <state SSID="10">
      <P Name="labelString">Transition_To_Level
during:
    % Calculate distance &apos;d&apos; traveled along the initial heading vector
    dx = p_actual(1) - p1(1);
    dy = p_actual(2) - p1(2);
    d = dx * cos(heading_initial) + dy * sin(heading_initial);
    % Project reference position strictly along the heading vector
    p_ref(1) = p1(1) + d * cos(heading_initial);
    p_ref(2) = p1(2) + d * sin(heading_initial);
    p_ref(3) = -6; % Target 6m altitude for level flight
    q_ref = eul2quat([heading_initial, 14.3*(pi/180), 0], &apos;ZYX&apos;)&apos;;
    u_ref = 7 * cos(14.3*(pi/180));</P>
      <P Name="position">[355 107.6897 354.4022 182.7006]</P>
      <P Name="fontSize">12</P>
      <P Name="subviewer">98</P>
      <P Name="type">OR_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml/>
    </state>
    <state SSID="12">
      <P Name="labelString">Back_Transition
entry:
    % Place p2 5m behind the aircraft along its
    %heading line, gaining altitude to 18m
    p_ref(1) = p_actual(1) %- 5 * cos(heading_initial);
    p_ref(2) = p_actual(2) %- 5 * sin(heading_initial);
    p_ref(3) = -18;
    q_ref = eul2quat([heading_initial, pi/2, 0], &apos;ZYX&apos;)&apos;;
    u_ref = 7 * cos(14.3*(pi/180));
    t_2 = t;</P>
      <P Name="position">[776.6022 121.84 314.9796 154.4]</P>
      <P Name="fontSize">12</P>
      <P Name="subviewer">98</P>
      <P Name="type">OR_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml/>
    </state>
    <state SSID="20">
      <P Name="labelString">Hover_Save
entry:
    % Lock current states for descent tracking
    p3 = p_actual;
    t3 = t;
    %p_ref(3) = p3(3)
    q_ref = eul2quat([heading_initial, pi/2, 0], &apos;ZYX&apos;)&apos;;
    u_ref = 0;</P>
      <P Name="position">[1158.7818 142 286 114.4]</P>
      <P Name="fontSize">12</P>
      <P Name="subviewer">98</P>
      <P Name="type">OR_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml/>
    </state>
    <state SSID="8">
      <P Name="labelString">Vertical_Takeoff_Climb
entry:
    % Target 5m altitude directly above starting point
    p_ref = [p1(1); p1(2); -5];
    q_ref = eul2quat([heading_initial, pi/2, 0], &apos;ZYX&apos;)&apos;;
    u_ref = 0;
    landing_flag = false;</P>
      <P Name="position">[36.0203 146.48 282.8 105.12]</P>
      <P Name="fontSize">12</P>
      <P Name="subviewer">98</P>
      <P Name="type">OR_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml/>
    </state>
    <state SSID="24">
      <P Name="labelString">Vertical_Landing
entry:
    % Terminate flight mission by activating landing flag to cut actuators
    u_ref = 0;
    q_ref = eul2quat([heading_initial, pi/2, 0], &apos;ZYX&apos;)&apos;;
    p_ref(3) = 0;
    landing_flag = true;</P>
      <P Name="position">[533.7561 370.464 276.24 127.2]</P>
      <P Name="fontSize">12</P>
      <P Name="subviewer">98</P>
      <P Name="type">OR_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml/>
    </state>
    <state SSID="13">
      <P Name="labelString">Vertical_Descent
during:
    % Descent velocity V_desc = 0.5 m/s
    p_ref(1) = p3(1);
    p_ref(2) = p3(2);
    p_ref(3) = -18 + 0.5 * (t - t3);
    u_ref = -0.5;
    q_ref = eul2quat([heading_initial, pi/2, 0], &apos;ZYX&apos;)&apos;;</P>
      <P Name="position">[1105.2582 370.464 297.0384 127.2]</P>
      <P Name="fontSize">12</P>
      <P Name="subviewer">98</P>
      <P Name="type">OR_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml/>
    </state>
