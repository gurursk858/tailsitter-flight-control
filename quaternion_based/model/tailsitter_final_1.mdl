__MWOPC_PART_BEGIN__ /simulink/stateflow/chart_167.xml
<?xml version="1.0" encoding="utf-8"?>
<chart id="167">
  <P Name="name">Plant1/Aero_dynmaics</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">167</P>
  <subviewS/>
  <P Name="ssIdHighWaterMark">11</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">25</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">Aero_Dynamics_Simple</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">167</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [F_a_total, M_a_total] = Aero_Dynamics_Simple(v_b, w_b, delta, T_vec, v_w)

    F_a_total = zeros(3,1);
    M_a_total = zeros(3,1);

    %% --- CONSTANTS ---
    rho       = 1.225;
    b         = 0.5;
    r_p       = 0.0625;
    l         = 0.145;
    S         = 0.08;
    Lambda    = 19.8 * (pi/180);
    CD_0      = 0.02;
    k_0       = 0.87;

    %% --- DERIVED ---
    A_R       = b^2 / S;
    term1     = (2*cos(Lambda)) / A_R;
    C_L_alpha = (2*pi*cos(Lambda)) / (term1 + sqrt(1 + term1^2));

    % Empirical correction ratios
    cx_ratio = 9.91e-4 / 2.35e-3;   
    cy_ratio = 4.74e-4 / 3.50e-4;   

    %% --- STRIP GEOMETRY ---
    y_edges = [-0.25, -0.1892, -0.1450, -0.1008, -0.0336, ...
                0.0336,  0.1008,  0.1450,  0.1892,  0.25];

    c_root = 0.2292;
    dx_CM  = 0.130;  

    slip_flag = [0, 1, 1, 0, 0, 0, 2, 2, 0];
    delta_i = [delta(1), delta(1), delta(1), 0, 0, 0, ...
               delta(2), delta(2), delta(2)];

    u   = v_b(1);
    r   = w_b(3);   

    v_in_l = u + r*l - v_w(1);
    v_in_r = u - r*l - v_w(1);

    vl_sq = max(0, v_in_l^2 + (2*T_vec(1)) / (rho*pi*r_p^2));
    vr_sq = max(0, v_in_r^2 + (2*T_vec(2)) / (rho*pi*r_p^2));

    %% --- ACCUMULATORS ---
    F_total   = zeros(3,1);
    M_zero    = zeros(3,1);   
    M_delta   = zeros(3,1);   

    %% --- STRIP LOOP ---
    for i = 1:9
        b_i = y_edges(i+1) - y_edges(i);
        y_i = y_edges(i) + b_i/2;
        
        % Corrected Delta Wing Geometry
        c_i = c_root - abs(y_i)*tan(Lambda);

        LE_x  = (0.2292 - dx_CM) - abs(y_i)*tan(Lambda);
        x_i   = LE_x - 0.25*c_i;
        r_i   = [x_i; y_i; 0];

        v_i = v_b + cross(w_b, r_i) - v_w;

        if slip_flag(i) == 1
            v_i(1) = sqrt(vl_sq);
        elseif slip_flag(i) == 2
            v_i(1) = sqrt(vr_sq);
        end

        alpha_i = atan2(v_i(3), v_i(1));
        q_i     = 0.5 * rho * b_i * c_i * (v_i(1)^2 + v_i(3)^2);

        alpha_stall = 18*(pi/180);
        sigma   = 1 / (1 + exp(-50*(abs(alpha_i) - alpha_stall)));
        CL_flat = sin(2*alpha_i);
        CD_flat = 2*(sin(alpha_i))^2;

        % --- Baseline (delta = 0) aerodynamics ---
        CL_0 = (1-sigma)*(C_L_alpha*alpha_i)       + sigma*CL_flat;
        CD_0s= (1-sigma)*(CD_0 + (C_L_alpha*alpha_i)^2/(pi*k_0*A_R)) + sigma*CD_flat;

        F_i_0 = q_i * [ CL_0*sin(alpha_i) - CD_0s*cos(alpha_i);
                         0;
                        -CL_0*cos(alpha_i) - CD_0s*sin(alpha_i) ];

        % SIMPLIFIED FOR HOVER: Zero out the complex aircraft pitch shape
        CM_i_0 = 0; 
        M_zero = M_zero + [0; 0; 0] + cross(r_i, F_i_0);

        % --- Deflected (delta_i) aerodynamics ---
        alpha_eff = alpha_i + 0.5*delta_i(i);
        CL_d = (1-sigma)*(C_L_alpha*alpha_eff)       + sigma*CL_flat;
        CD_ds= (1-sigma)*(CD_0 + (C_L_alpha*alpha_eff)^2/(pi*k_0*A_R)) + sigma*CD_flat;

        F_i_d = q_i * [ CL_d*sin(alpha_i) - CD_ds*cos(alpha_i);
                         0;
                        -CL_d*cos(alpha_i) - CD_ds*sin(alpha_i) ];

        % Controller still needs to know the elevons work!
        CM_i_d = - 0.22*delta_i(i);

        F_total = F_total + F_i_d;
        M_delta = M_delta + [0; q_i*c_i*CM_i_d; 0] + cross(r_i, F_i_d);
    end

    %% --- EMPIRICAL SCALING ---
    L_out = M_zero(1) + cx_ratio*(M_delta(1) - M_zero(1));
    M_out = M_zero(2) + cy_ratio*(M_delta(2) - M_zero(2));
    N_out = M_delta(3);

    F_a_total = F_total;
    M_a_total = [L_out; M_out; N_out];

end</P>
      </eml>
    </state>
    <data SSID="4" name="v_b">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="5" name="F_a_total">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="6" name="w_b">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="10" name="delta">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="8" name="T_vec">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="7" name="v_w">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="9" name="M_a_total">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <transition SSID="2">
      <P Name="labelString">{eML_blk_kernel();}</P>
      <P Name="labelPosition">[28.125 13.875 102.544 14.964]</P>
      <P Name="fontSize">12</P>
      <src>
        <P Name="intersection">[0 0 1 0 23.5747 14.625 0 0]</P>
      </src>
      <dst>
        <P Name="SSID">3</P>
        <P Name="intersection">[1 0 -1 0 23.5747 42.5747 0 0]</P>
      </dst>
      <P Name="midPoint">[23.5747 24.9468]</P>
      <P Name="dataLimits">[21.175 25.975 14.625 42.575]</P>
      <P Name="subviewer">167</P>
      <P Name="drawStyle">SMART</P>
      <slide>
        <P Name="sticky">BOTH_STICK</P>
      </slide>
      <P Name="executionOrder">1</P>
    </transition>
    <junction SSID="3">
      <P Name="position">[23.5747 49.5747 7]</P>
