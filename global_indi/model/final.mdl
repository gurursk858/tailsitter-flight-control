__MWOPC_PART_BEGIN__ /simulink/stateflow/chart_134.xml
<?xml version="1.0" encoding="utf-8"?>
<chart id="134">
  <P Name="name">Controller_flight/MATLAB Function8</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">134</P>
  <P Name="ssIdHighWaterMark">19</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">10</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">Aero_Model</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">134</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [f_world, m_b, v_alpha,f_d_alpha_hpf]   = Aero_Model(omega, delta, v_world, xi, delta_hpf)
    % ---------------------------------------------------------------------
    % PARAMETERS (From Tables 1 &amp; 2 of the paper)
    % ---------------------------------------------------------------------
    alpha_0    = -2 * pi / 180; % Zero-lift angle 
    alpha_T    = -5 * pi / 180; % Thrust angle
    alpha_bar  = alpha_0 + alpha_T;
    
    l_Ty       = 0.15;  % Motor y-axis offset
    l_dy       = 0.15;  % Flap y-axis offset
    l_dz       = 0.075; % Flap z-axis offset (aerodynamic center)
    
    c_T        = 1.5e-5; % Thrust coeff
    c_mu       = 2.0e-7; % Torque coeff
    
    c_DT       = 0;
    c_LT       = 2.23;
    c_LT_delta = 1.25;
    c_DV       = 0;
    c_LV       = 0.29;
    c_LV_delta = 0.18;
    c_mu_T     = -0.025; % Pitch moment due to thrust
    xi = xi / norm(xi);
    w = xi(1); x = xi(2); y = xi(3); z = xi(4);

    % Body-to-World Rotation Matrix
    R_b_i = [1 - 2*(y^2 + z^2), 2*(x*y - w*z),     2*(x*z + w*y);
             2*(x*y + w*z),     1 - 2*(x^2 + z^2), 2*(y*z - w*x);
             2*(x*z - w*y),     2*(y*z + w*x),     1 - 2*(x^2 + y^2)];
             
    v_body = R_b_i&apos; * v_world; % World to Body velocity

    R_b_to_alpha = [cos(alpha_0), 0, -sin(alpha_0);
                    0,            1,  0;
                    sin(alpha_0), 0,  cos(alpha_0)];
    v_alpha = R_b_to_alpha * v_body;
    v_norm = norm(v_alpha);
    vx_a = v_alpha(1);
    vz_a = v_alpha(3);
    
                 
    % 4. Total Rotation (Alpha -&gt; Body -&gt; World)
    
    % ---------------------------------------------------------------------
    % STEP 1: THRUST &amp; TORQUE MAGNITUDES (Eq. 6 &amp; Eq. 12)
    % ---------------------------------------------------------------------
    T_1 = c_T * omega(1)^2;
    T_2 = c_T * omega(2)^2;
    
    mu_1 = c_mu * omega(1)^2;
    mu_2 = -c_mu * omega(2)^2; % Opposite rotation direction

    % ---------------------------------------------------------------------
    % STEP 2: FORCES IN ZERO-LIFT ALPHA FRAME (Eq. 5, 7, 8, 9)
    % ---------------------------------------------------------------------
    % Base vectors for convenience
    ix = [1; 0; 0];
    iz = [0; 0; 1];

    % Thrust force vectors (Eq. 5)
    f_T1_alpha = [ cos(alpha_bar)*(1 - c_DT); 0; sin(alpha_bar)*(c_LT - 1) ] * T_1;
    f_T2_alpha = [ cos(alpha_bar)*(1 - c_DT); 0; sin(alpha_bar)*(c_LT - 1) ] * T_2;
    f_T_alpha = f_T1_alpha + f_T2_alpha;
    
    % Flap force vectors (Eq. 7)
    % Note: Lift acts purely in the z-axis of the alpha frame
    f_d1_alpha = -[ 0; 0; c_LT_delta * cos(alpha_bar) * T_1 + c_LV_delta * v_norm * vx_a ] * delta(1);
    f_d2_alpha = -[ 0; 0; c_LT_delta * cos(alpha_bar) * T_2 + c_LV_delta * v_norm * vx_a ] * delta(2);
    f_d_alpha = f_d1_alpha + f_d2_alpha;
    
    % Wing force vector (Eq. 8)
    f_w_alpha = -[ c_DV * vx_a; 0; c_LV * vz_a ] * v_norm;
    
    % Total force in alpha frame (Eq. 9)
    f_alpha = f_T_alpha + f_d_alpha + f_w_alpha;

    % ---------------------------------------------------------------------
    % STEP 3: MOMENTS IN BODY FRAME (Eq. 10, 11, 13, 14)
    % ---------------------------------------------------------------------
    % Rotation matrix from Alpha frame to Body frame
    % Alpha is pitched up by alpha_0 relative to body. 
    R_alpha_b = [ cos(alpha_0),  0, sin(alpha_0);
                  0,             1, 0;
                 -sin(alpha_0),  0, cos(alpha_0) ];
    f_body = R_alpha_b * f_alpha;
    f_world = R_b_i * f_body;             
    % Moment due to thrust (Eq. 10)
    term1_T = l_Ty * iz&apos; * R_alpha_b * (f_T2_alpha - f_T1_alpha);
    term2_T = c_mu_T * (T_1 + T_2);
    term3_T = l_Ty * ix&apos; * R_alpha_b * (f_T1_alpha - f_T2_alpha);
    m_T = [term1_T; term2_T; term3_T];
    
    % Moment due to motor torque (Eq. 11)
    m_mu = [ cos(alpha_T); 0; -sin(alpha_T) ] * (mu_1 + mu_2);
    
    % Moment due to flaps (Eq. 13)
    term1_d = l_dy * cos(alpha_0) * iz&apos; * (f_d2_alpha - f_d1_alpha);
    term2_d = l_dz * iz&apos; * (f_d1_alpha + f_d2_alpha);
    term3_d = l_dy * sin(alpha_0) * iz&apos; * (f_d1_alpha - f_d2_alpha);
    m_delta = [term1_d; term2_d; term3_d];
    
    % Total aerodynamic moment in body frame (Eq. 14)
    m_b = m_T + m_mu + m_delta;

    f_d1_alpha1 = -[ 0; 0; c_LT_delta * cos(alpha_bar) * T_1 + c_LV_delta * v_norm * vx_a ] * delta_hpf(1);
    f_d2_alpha2 = -[ 0; 0; c_LT_delta * cos(alpha_bar) * T_2 + c_LV_delta * v_norm * vx_a ] * delta_hpf(2);
    f_d_alpha_hpf = f_d1_alpha1 + f_d2_alpha2;
end</P>
      </eml>
    </state>
    <data SSID="7" name="omega">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="8" name="delta">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="16" name="v_world">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="5" name="f_world">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="9" name="m_b">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="14" name="xi">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="15" name="v_alpha">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="17" name="f_d_alpha_hpf">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="19" name="delta_hpf">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <transition SSID="2">
      <P Name="labelString">{eML_blk_kernel();}</P>
      <P Name="labelPosition">[28.125 13.875 102.544 14.964]</P>
      <P Name="fontSize">12</P>
      <src>
        <P Name="intersection">[0 0 1 0 23.5747 14.625 0 0]</P>
      </src>
      <dst>
        <P Name="SSID">3</P>
        <P Name="intersection">[1 0 -1 0 23.5747 42.5747 0 0]</P>
      </dst>
      <P Name="midPoint">[23.5747 24.9468]</P>
      <P Name="dataLimits">[21.175 25.975 14.625 42.575]</P>
      <P Name="subviewer">134</P>
