<?xml version="1.0" encoding="utf-8"?>
<chart id="94">
  <P Name="name">Controller_flight/MATLAB Function5</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">94</P>
  <P Name="ssIdHighWaterMark">16</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">7</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">fft</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">94</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [T_c, xi_c, theta_bar, psi_ref, phi, x1, z1] = fft(psi_ref, f_c_i, v_i, delta, xi)
    % ---------------------------------------------------------------------
    % AERODYNAMIC &amp; GEOMETRIC PARAMETERS (From Table 1 &amp; 2 of the paper)
    % ---------------------------------------------------------------------
    alpha_0    = -2 * pi / 180; % Zero-lift angle (approximate example)
    alpha_T    = -5 * pi / 180; % Thrust angle
    alpha_bar  = alpha_0 + alpha_T;
    
    % Aerodynamic coefficients (Experimental values from Table 2)
    c_DT       = 0;
    c_LT       = 2.23;
    c_LT_delta = 1.25;
    c_DV       = 0;
    c_LV       = 0.29;
    c_LV_delta = 0.18;
    delta1 = delta(1) + delta(2);
    v_norm = norm(v_i);
    b_y_i = [2*(xi(2)*xi(3) - xi(1)*xi(4)); 1 - 2*(xi(2)^2 + xi(4)^2); 2*(xi(3)*xi(4) + xi(1)*xi(2))]; 
    %---------------------------------------------
    % STEP 1: YAW ROTATION (Eq. 17 dependencies)
    % ---------------------------------------------------------------------
    % Rotation matrix for yaw reference around the z-axis
    R_i_psi = [ cos(psi_ref), sin(psi_ref), 0;
               -sin(psi_ref), cos(psi_ref), 0;
                0,            0,            1];

    % ---------------------------------------------------------------------
    % STEP 2: ROLL CALCULATION &amp; BRANCHING (Eq. 17)
    % ---------------------------------------------------------------------
    f_psi = R_i_psi * f_c_i;
    beta_x = f_psi(2); % i_y^T * R_i^psi * f_c_i
    beta_z = f_c_i(3); % i_z^T * f_c_i

    phi_base = -atan2(beta_x, beta_z);
    
    % Branching: We must choose the k*pi addition that aligns the new 
    % y-axis as closely as possible to the current vehicle y-axis (b_y_i)
    phi_0 = phi_base;
    phi_1 = phi_base + pi;
    
    % Test k=0
    R_psi_phi_0 = [1, 0, 0; 0, cos(phi_0), sin(phi_0); 0, -sin(phi_0), cos(phi_0)];
    R_i_phi_0 = R_psi_phi_0 * R_i_psi;
    y_phi_0 = R_i_phi_0&apos; * [0; 1; 0]; % Map y-axis back to world
    
    % Test k=1
    R_psi_phi_1 = [1, 0, 0; 0, cos(phi_1), sin(phi_1); 0, -sin(phi_1), cos(phi_1)];
    R_i_phi_1 = R_psi_phi_1 * R_i_psi;
    y_phi_1 = R_i_phi_1&apos; * [0; 1; 0];
    
    if dot(b_y_i, y_phi_0) &gt;= dot(b_y_i, y_phi_1)
        phi = phi_0;
        R_i_phi = R_i_phi_0;
    else
        phi = phi_1;
        R_i_phi = R_i_phi_1;
    end

    % ---------------------------------------------------------------------
    % STEP 3: TRANSFORM TO PHI FRAME
    % ---------------------------------------------------------------------
    f_phi = R_i_phi * f_c_i;
    v_phi = R_i_phi * v_i;

    fx = f_phi(1); fz = f_phi(3);
    vx = v_phi(1); vz = v_phi(3);

    % ---------------------------------------------------------------------
    % STEP 4: ETA CALCULATION (Eq. 23)
    % NOTE: delta (delta_1 + delta_2) is actively used here!
    % ---------------------------------------------------------------------
    num_eta = sin(alpha_bar)*(c_LT - 1) - cos(alpha_bar)*c_LT_delta*(delta1 / 2);
    den_eta = cos(alpha_bar)*(1 - c_DT);
    eta = num_eta / den_eta;

    % ---------------------------------------------------------------------
    % STEP 5: PITCH CALCULATION &amp; BRANCHING (Eq. 21 and Eq. 22)
    % ---------------------------------------------------------------------
    sigma_x = eta*(fx + c_DV*v_norm*vx) - c_LV_delta*delta1*v_norm*vx - c_LV*v_norm*vz - fz;
    sigma_z = eta*(fz + c_DV*v_norm*vz) - c_LV_delta*delta1*v_norm*vz + c_LV*v_norm*vx + fx;
 
    theta_bar_base = atan2(sigma_x, sigma_z);
    
    % Thrust denominator is constant
    T_denom = cos(alpha_bar) * (1 - c_DT);
    
    % Check T_c for k=0
    T_num_0 = cos(theta_bar_base)*fx - sin(theta_bar_base)*fz + c_DV*v_norm*(cos(theta_bar_base)*vx - sin(theta_bar_base)*vz);
    T_0 = T_num_0 / T_denom;
    
    % Branching: Collective thrust must be non-negative
    if T_0 &gt;= 0
        theta_bar = theta_bar_base;
        T_c = T_0;
    else
        theta_bar = theta_bar_base + pi;
        T_num_1 = cos(theta_bar)*fx - sin(theta_bar)*fz + c_DV*v_norm*(cos(theta_bar)*vx - sin(theta_bar)*vz);
        T_c = T_num_1 / T_denom;
    end
    %theta_bar = theta_bar_base;
    % ---------------------------------------------------------------------
    % STEP 6: ZXY EULER TO QUATERNION CONVERSION
    % ---------------------------------------------------------------------
    theta = theta_bar + alpha_0; % Convert from zero-lift frame back to body frame
    x1 = fx;
    z1 = fz;
    % Compute half-angles
    cy = cos(psi_ref/2); sy = sin(psi_ref/2); % Yaw
    cr = cos(phi/2);     sr = sin(phi/2);     % Roll
    cp = cos(theta/2);   sp = sin(theta/2);   % Pitch
    
    % Hamilton Product for Z-X-Y Sequence (q_yaw * q_roll * q_pitch)
    % Resulting commanded attitude quaternion xi_c
    qw = cy*cr*cp - sy*sr*sp;
    qx = cy*sr*cp - sy*cr*sp;
    qy = cy*cr*sp + sy*sr*cp;
    qz = sy*cr*cp + cy*sr*sp;
    
    xi_c = [qw; qx; qy; qz];
    
    % Normalize to prevent floating point drift
    xi_c = xi_c / norm(xi_c);
end</P>
      </eml>
    </state>
    <data SSID="4" name="psi_ref">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
