<?xml version="1.0" encoding="utf-8"?>
<chart id="148">
  <P Name="name">Controller_flight/MATLAB Function9</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">148</P>
  <P Name="ssIdHighWaterMark">6</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">11</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">IMU_to_World_Accel</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">148</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function a_world = IMU_to_World_Accel(a_meas, xi)
    % 1. Extract Quaternion to build Body-to-World Rotation (R_b_i)
    w = xi(1); x = xi(2); y = xi(3); z = xi(4);
    R_b_i = [1 - 2*(y^2 + z^2), 2*(x*y - w*z),     2*(x*z + w*y);
             2*(x*y + w*z),     1 - 2*(x^2 + z^2), 2*(y*z - w*x);
             2*(x*z - w*y),     2*(y*z + w*x),     1 - 2*(x^2 + y^2)];

    % 2. Rotate IMU body measurement into the World Frame
    a_rotated = R_b_i * a_meas;

    % 3. Subtract Gravity 
    % The IMU feels 9.81 pushing UP. Gravity pulls 9.81 DOWN (+Z in NED).
    % By adding the gravity vector, they perfectly cancel out in a hover.
    a_world = a_rotated + [0; 0; 9.81];
end</P>
      </eml>
    </state>
    <data SSID="4" name="a_meas">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="6" name="xi">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="5" name="a_world">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <transition SSID="2">
      <P Name="labelString">{eML_blk_kernel();}</P>
      <P Name="labelPosition">[28.125 13.875 102.544 14.964]</P>
      <P Name="fontSize">12</P>
      <src>
        <P Name="intersection">[0 0 1 0 23.5747 14.625 0 0]</P>
      </src>
      <dst>
        <P Name="SSID">3</P>
        <P Name="intersection">[1 0 -1 0 23.5747 42.5747 0 0]</P>
      </dst>
      <P Name="midPoint">[23.5747 24.9468]</P>
      <P Name="dataLimits">[21.175 25.975 14.625 42.575]</P>
      <P Name="subviewer">148</P>
      <P Name="drawStyle">SMART</P>
      <slide>
        <P Name="sticky">BOTH_STICK</P>
      </slide>
      <P Name="executionOrder">1</P>
    </transition>
    <junction SSID="3">
      <P Name="position">[23.5747 49.5747 7]</P>
      <P Name="subviewer">148</P>
      <P Name="type">CONNECTIVE_JUNCTION</P>
    </junction>
  </Children>
</chart>

__MWOPC_PART_BEGIN__ /simulink/stateflow/chart_156.xml
<?xml version="1.0" encoding="utf-8"?>
<chart id="156">
  <P Name="name">Plant/MATLAB Function1</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">156</P>
  <P Name="ssIdHighWaterMark">13</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">12</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">Plant_Aerodynamics</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">156</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [F_net_body, M_net_body] = Plant_Aerodynamics(omega_true, delta_true, v_world, xi)
    % =====================================================================
    % Tal &amp; Karaman Theta-Theory Forward Aerodynamic Plant Model
    % =====================================================================

    % ---------------------------------------------------------------------
    % 1. PHYSICAL &amp; AERODYNAMIC PARAMETERS (Exact Paper Values)
    % ---------------------------------------------------------------------
    c_T        = 1.5e-5;    % Propeller thrust coefficient
    c_mu       = 2.0e-7;    % Propeller torque coefficient
    l_Ty       = 0.15;      % Motor y-axis offset (m)
    l_dy       = 0.15;      % Flap y-axis offset (m)
    l_dz       = 0.075;     % Flap z-axis offset (m)

    c_DT       = 0;         % Profile drag coefficient due to thrust
    c_LT       = 2.23;      % Lift coefficient due to thrust (prop-wash slipstream)
    c_LT_delta = 1.25;      % Lift coefficient due to flap deflection under thrust
    c_DV       = 0;         % Drag coefficient due to free-stream velocity
    c_LV       = 0.29;      % Lift coefficient due to free-stream velocity
    c_LV_delta = 0.18;      % Lift coefficient due to flap deflection under free-stream
    c_mu_T     = -0.025;    % Pitching moment coefficient due to thrust offset

    alpha_0    = -2 * pi / 180; % Zero-lift angle of attack (-2 deg)
    alpha_T    = -5 * pi / 180; % Thrust line tilt angle (-5 deg)
    alpha_bar  = alpha_0 + alpha_T;
    ix = [1;0;0];
    iz = [0;0;1];
    % ---------------------------------------------------------------------
    % 2. KINEMATICS &amp; FRAME TRANSFORMATIONS (World -&gt; Body -&gt; Alpha)
    % ---------------------------------------------------------------------
    % Protect against quaternion normalization drift over long runs
    xi = xi / norm(xi);
    w = xi(1); x = xi(2); y = xi(3); z = xi(4);

    % Build Body-to-World Rotation Matrix (R_b_i)
    R_b_i = [1 - 2*(y^2 + z^2), 2*(x*y - w*z),     2*(x*z + w*y);
             2*(x*y + w*z),     1 - 2*(x^2 + z^2), 2*(y*z - w*x);
             2*(x*z - w*y),     2*(y*z + w*x),     1 - 2*(x^2 + y^2)];

    % Transform World Velocity to Body Frame
    v_body = R_b_i&apos; * v_world; 

    % Build Alpha-to-Body Rotation Matrix (R_alpha_b)
    R_alpha_b = [ cos(alpha_0),  0, sin(alpha_0);
                  0,             1, 0;
                 -sin(alpha_0),  0, cos(alpha_0) ];

    % Transform Body Velocity to Zero-Lift Alpha Frame
    v_alpha = R_alpha_b&apos; * v_body; 
    v_norm  = norm(v_alpha);
    vx_a    = v_alpha(1);
    vz_a    = v_alpha(3);

    % ---------------------------------------------------------------------
    % 3. INDIVIDUAL ROTOR THRUST &amp; TORQUE GENERATION (Eq. 5, 6, 11)
    % ---------------------------------------------------------------------
    T_1 = c_T * omega_true(1)^2;
    T_2 = c_T * omega_true(2)^2;
    T_c = T_1 + T_2; % Total collective thrust

    mu_1 = c_mu * omega_true(1)^2;
    mu_2 = -c_mu * omega_true(2)^2; % Counter-rotating propeller torque

    % ---------------------------------------------------------------------
    % 4. TOTAL FORCE GENERATION (Calculated in Alpha Frame -&gt; Rotated to Body)
    % ---------------------------------------------------------------------
    % Mean symmetric flap deflection for longitudinal aerodynamics
    delta_mean = (delta_true(1) + delta_true(2));

    % Combined Aerodynamic + Thrust Forces in the Zero-Lift (Alpha) Frame
    F_x_alpha = -c_DV * v_norm * vx_a - c_DT * T_c*cos(alpha_bar) + T_c * cos(alpha_bar);
    F_z_alpha = -c_LV * v_norm * vz_a + c_LT * T_c*sin(alpha_bar) - c_LV_delta * v_norm * vx_a* delta_mean - c_LT_delta*cos(alpha_bar)*(T_1*delta_true(1) + T_2*delta_true(2)) - T_c * sin(alpha_bar);

    F_net_alpha = [F_x_alpha; 0; F_z_alpha];

    % Rotate Total Force Vector back into the structural Body Frame
    F_net_body = R_alpha_b * F_net_alpha;

    % ---------------------------------------------------------------------
    % 5. TOTAL MOMENT GENERATION (Direct Body Frame Formulation, Eq. 10, 12, 39)
    % ---------------------------------------------------------------------
    % 5a. Moments induced by the structural Thrust vector lines (Eq. 10)
    f_T1_alpha = [ cos(alpha_bar)*(1 - c_DT); 0; sin(alpha_bar)*(c_LT - 1) ] * T_1;
    f_T2_alpha = [ cos(alpha_bar)*(1 - c_DT); 0; sin(alpha_bar)*(c_LT - 1) ] * T_2;
    %f_T_alpha = f_T1_alpha + f_T2_alpha;

    f_d1_alpha = -[ 0; 0; c_LT_delta * cos(alpha_bar) * T_1 + c_LV_delta * v_norm * vx_a ] * delta_true(1);
    f_d2_alpha = -[ 0; 0; c_LT_delta * cos(alpha_bar) * T_2 + c_LV_delta * v_norm * vx_a ] * delta_true(2);
    %f_d_alpha = f_d1_alpha + f_d2_alpha;

    term1_T = l_Ty * iz&apos; * R_alpha_b * (f_T2_alpha - f_T1_alpha);
    term2_T = c_mu_T * (T_1 + T_2);
    term3_T = l_Ty * ix&apos; * R_alpha_b * (f_T1_alpha - f_T2_alpha);
    m_T = [term1_T; term2_T; term3_T];
    
    % Moment due to motor torque (Eq. 11)
    m_mu = [ cos(alpha_T); 0; -sin(alpha_T) ] * (mu_1 + mu_2);
    
    % Moment due to flaps (Eq. 13)
    term1_d = l_dy * cos(alpha_0) * iz&apos; * (f_d2_alpha - f_d1_alpha);
    term2_d = l_dz * iz&apos; * (f_d1_alpha + f_d2_alpha);
    term3_d = l_dy * sin(alpha_0) * iz&apos; * (f_d1_alpha - f_d2_alpha);
    m_delta = [term1_d; term2_d; term3_d];
    
    % Total aerodynamic moment in body frame (Eq. 14)
    M_net_body = m_T + m_mu + m_delta;
end
% function y = func(x)
% y = x^2;
% end</P>
      </eml>
    </state>
    <data SSID="4" name="omega_true">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="5" name="F_net_body">
