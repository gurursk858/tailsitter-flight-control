__MWOPC_PART_BEGIN__ /simulink/stateflow/chart_121.xml
<?xml version="1.0" encoding="utf-8"?>
<chart id="121">
  <P Name="name">Controller_flight/MATLAB Function7</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">121</P>
  <P Name="visible">1</P>
  <subviewS/>
  <P Name="ssIdHighWaterMark">14</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">9</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">fcn</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">121</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [x_ref, v_ref, a_ref, j_ref, psi_ref, psi_dot_ref, y1] = fcn(t)

    y1 = t;

    
    %--- TUNING PARAMETERS ---


    % For lemniscate trajectory


    A_x = 15.0;      % Amplitude of X-axis sweep (meters)
    A_y = 15.0;      % Amplitude of Y-axis sweep (meters)
    Z_alt = -10.0;  % Cruising altitude (NED, so -10 is UP)
    omega = 0.15;    % Flight speed/frequency (rad/s) -&gt; Increase for more aggressive flight

    % ---------------------------------------------------------------------
    % 1. POSITION (x_ref)
    % A classic figure-8 (Lemniscate/Lissajous) parameterized by time
    % ---------------------------------------------------------------------
    x = A_x * sin(omega * t);
    y = A_y * sin(2 * omega * t); 
    z = Z_alt;
    x_ref = [x; y; z];

    % ---------------------------------------------------------------------
    % 2. VELOCITY (v_ref) - 1st Derivative
    % ---------------------------------------------------------------------
    vx = A_x * omega * cos(omega * t);
    vy = A_y * 2 * omega * cos(2 * omega * t);
    vz = 0;
    v_ref = [vx; vy; vz];

    % ---------------------------------------------------------------------
    % 3. ACCELERATION (a_ref) - 2nd Derivative
    % ---------------------------------------------------------------------
    ax = -A_x * omega^2 * sin(omega * t);
    ay = -A_y * (2 * omega)^2 * sin(2 * omega * t);
    az = 0;
    a_ref = [ax; ay; az];

    % ---------------------------------------------------------------------
    % 4. JERK (j_ref) - 3rd Derivative
    % Crucial for the angular velocity feedforward in the flatness transform
    % ---------------------------------------------------------------------
    jx = -A_x * omega^3 * cos(omega * t);
    jy = -A_y * (2 * omega)^3 * cos(2 * omega * t);
    jz = 0;
    j_ref = [jx; jy; jz];
   



    % For circular trajectory

    % R = 25.0;        % Radius of the circle sweep (meters)
    % Z_alt = -10.0;  % Cruising altitude
    % omega = 0.15;   % Flight speed (rad/s)
    % 
    % % ---------------------------------------------------------------------
    % % 1. POSITION (Complete 360 Continuous Circle)
    % % ---------------------------------------------------------------------
    % x = R * sin(omega * t);
    % y = R - R * cos(omega * t); 
    % z = Z_alt;
    % x_ref = [x; y; z];
    % 
    % % ---------------------------------------------------------------------
    % % 2. VELOCITY
    % % ---------------------------------------------------------------------
    % vx = R * omega * cos(omega * t);
    % vy = R * omega * sin(omega * t);
    % vz = 0;
    % v_ref = [vx; vy; vz];
    % 
    % % ---------------------------------------------------------------------
    % % 3. ACCELERATION
    % % ---------------------------------------------------------------------
    % ax = -R * omega^2 * sin(omega * t);
    % ay = R * omega^2 * cos(omega * t);
    % az = 0;
    % a_ref = [ax; ay; az];
    % 
    % % ---------------------------------------------------------------------
    % % 4. JERK
    % % ---------------------------------------------------------------------
    % jx = -R * omega^3 * cos(omega * t);
    % jy = -R * omega^3 * sin(omega * t);
    % jz = 0;
    % j_ref = [jx; jy; jz];
    

    % VTOL

    % --- TIMING PARAMETERS (Safe Repositioning Profile) ---
    % T_takeoff  = 5.0;   % 0 to 5: Vertical Climb
    % T_hover_1  = 8.0;   % 5 to 8: Stabilize Hover
    % T_cruise   = 840.0;  % 8 to 23: Slow, controlled forward flight (15 seconds)
    % T_hover_2  = 956.0;  % 23 to 26: Stabilize at destination
    % T_land     = 962.0;  % 26 to 32: Vertical Descent to ground
    % 
    % % --- WAYPOINTS (Meters) ---
    % Z_ground = 0.0;
    % Z_alt    = -10.0;
    % X_start  = 0.0;
    % X_dest   = 4000.0;    % Shortened to prevent high-speed Parachute Effect
    % 
    % %x = 0; y = 0; z = 0;
    % y = 0;
    % vx = 0; vy = 0; vz = 0;
    % ax = 0; ay = 0; az = 0;
    % jx = 0; jy = 0; jz = 0;
    % 
    % % Quintic Polynomial Blending
    % function [pos, vel, acc, jerk] = quintic(t_curr, t0, tf, p0, pf)
    %     if t_curr &lt;= t0
    %         pos = p0; vel = 0; acc = 0; jerk = 0;
    %     elseif t_curr &gt;= tf
    %         pos = pf; vel = 0; acc = 0; jerk = 0;
    %     else
    %         dt = tf - t0;
    %         s = (t_curr - t0) / dt;
    %         dp = pf - p0;
    % 
    %         pos  = p0 + dp * (10*s^3 - 15*s^4 + 6*s^5);
    %         vel  = (dp / dt) * (30*s^2 - 60*s^3 + 30*s^4);
    %         acc  = (dp / dt^2) * (60*s - 180*s^2 + 120*s^3);
    %         jerk = (dp / dt^3) * (60 - 360*s + 360*s^2);
    %     end
    % end
    % 
    % % --- STATE MACHINE ---
    % if t &lt; T_takeoff % Climb
    %     [z, vz, az, jz] = quintic(t, 0, T_takeoff, Z_ground, Z_alt);
    %     x = X_start;
    % elseif t &lt; T_hover_1 % Hover
    %     z = Z_alt;
    %     x = X_start;
    % elseif t &lt; T_cruise % Cruise
    %     z = Z_alt;
    %     [x, vx, ax, jx] = quintic(t, T_hover_1, T_cruise, X_start, X_dest);
    % elseif t &lt; T_hover_2 % Hover
    %     z = Z_alt;
    %     x = X_dest;
    % else % Land
    %     [z, vz, az, jz] = quintic(t, T_hover_2, T_land, Z_alt, Z_ground);
    %     x = X_dest;
    % end
    % 
    % x_ref = [x; y; z];
    % v_ref = [vx; vy; vz];
    % a_ref = [ax; ay; az];
    % j_ref = [jx; jy; jz];

% % ADD THESE LINES (Aligns yaw with the velocity vector):
    vxy_sq = vx^2 + vy^2;
    if vxy_sq &gt; 1e-4
        psi_ref = atan2(vy, vx);
        psi_dot_ref = (vx*ay - vy*ax) / vxy_sq;
    else
        psi_ref = 0;
        psi_dot_ref = 0;
    end
end


</P>
      </eml>
    </state>
    <data SSID="6" name="x_ref">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="7" name="v_ref">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="8" name="a_ref">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="9" name="j_ref">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="10" name="psi_ref">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="11" name="psi_dot_ref">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="4" name="t">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="5" name="y1">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <transition SSID="2">
      <P Name="labelString">{eML_blk_kernel();}</P>
      <P Name="labelPosition">[28.125 13.875 102.544 14.964]</P>
      <P Name="fontSize">12</P>
      <src>
        <P Name="intersection">[0 0 1 0 23.5747 14.625 0 0]</P>
      </src>
      <dst>
        <P Name="SSID">3</P>
        <P Name="intersection">[1 0 -1 0 23.5747 42.5747 0 0]</P>
      </dst>
      <P Name="midPoint">[23.5747 24.9468]</P>
      <P Name="dataLimits">[21.175 25.975 14.625 42.575]</P>
      <P Name="subviewer">121</P>
      <P Name="drawStyle">SMART</P>
      <slide>
        <P Name="sticky">BOTH_STICK</P>
      </slide>
      <P Name="executionOrder">1</P>
    </transition>
    <junction SSID="3">
