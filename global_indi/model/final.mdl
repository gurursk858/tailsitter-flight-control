<chart id="111">
  <P Name="name">Controller_flight/MATLAB Function6</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">111</P>
  <P Name="ssIdHighWaterMark">8</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">8</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">Control_Allocation</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">111</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [omega, delta] = Control_Allocation(T_c, m_c, v_alpha)
    % ---------------------------------------------------------------------
    % AERODYNAMIC &amp; GEOMETRIC PARAMETERS (From Tables 1 &amp; 2)
    % ---------------------------------------------------------------------
    alpha_0    = -2 * pi / 180; % Zero-lift angle 
    alpha_T    = -5 * pi / 180; % Thrust angle
    alpha_bar  = alpha_0 + alpha_T;
    
    l_Ty       = 0.15;  % Motor y-axis offset (approximate, check your CAD)
    l_dy       = 0.15;  % Flap y-axis offset
    l_dz       = 0.075; % Flap z-axis offset (from paper text)
    
    c_T        = 1.5e-5; % Propeller thrust coefficient (requires your bench data)
    c_mu       = 2.0e-7; % Propeller torque coefficient (requires your bench data)
    
    c_DT       = 0;
    c_LT       = 2.23;
    c_LT_delta = 1.25;
    c_LV_delta = 0.18;
    c_mu_T     = -0.025; % Pitch moment due to thrust

    v_norm = norm(v_alpha);
    vx_a   = v_alpha(1);

    % ---------------------------------------------------------------------
    % STEP 1: DIFFERENTIAL THRUST CALCULATION (Eq. 37)
    % ---------------------------------------------------------------------
    mz = m_c(3); % Commanded yaw moment
    
    denom_delta_T = l_Ty * (cos(alpha_0)*cos(alpha_bar)*(1 - c_DT) - ...
                    sin(alpha_0)*sin(alpha_bar)*(c_LT - 1)) - ...
                    sin(alpha_T)*(c_mu / c_T);
                    
    delta_T = mz / denom_delta_T;

    % ---------------------------------------------------------------------
    % STEP 2: INDIVIDUAL MOTOR THRUSTS &amp; SPEEDS (Eq. 38 &amp; Eq. 6)
    % ---------------------------------------------------------------------
    T_1 = (T_c + delta_T) / 2;
    T_2 = (T_c - delta_T) / 2;
    
    % Protect against negative thrust commands before sqrt()
    T_1 = max(T_1, 0);
    T_2 = max(T_2, 0);
    
    omega_1 = sqrt(T_1 / c_T);
    omega_2 = sqrt(T_2 / c_T);
    
    omega = [omega_1; omega_2];

    % ---------------------------------------------------------------------
    % STEP 3: ISOLATE FLAP MOMENT (Eq. 10, 11, 14)
    % ---------------------------------------------------------------------
    % Moment due to thrust (Eq. 10)
    m_T = [ l_Ty * sin(alpha_T) * (T_2 - T_1);
            c_mu_T * (T_1 + T_2);
            l_Ty * cos(alpha_T) * (T_1 - T_2) ];
            
    % Moment due to motor torque (Eq. 11 &amp; 12)
    mu_1 = c_mu * omega_1^2;
    mu_2 = -c_mu * omega_2^2;
    
    m_mu = [ cos(alpha_T) * (mu_1 + mu_2);
             0;
            -sin(alpha_T) * (mu_1 + mu_2) ];
            
    % The remaining moment must be generated by the flaps
    m_delta = m_c - m_T - m_mu;
    
    mx_d = m_delta(1);
    my_d = m_delta(2);

    % ---------------------------------------------------------------------
    % STEP 4: FLAP INVERSION MATRIX (Eq. 40 &amp; 39)
    % ---------------------------------------------------------------------
    nu_1 = -c_LT_delta * cos(alpha_bar) * T_1 - c_LV_delta * v_norm * vx_a;
    nu_2 = -c_LT_delta * cos(alpha_bar) * T_2 - c_LV_delta * v_norm * vx_a;
    
    % Matrix from Eq. 39
    M_flap = [ -l_dy * cos(alpha_0) * nu_1,  l_dy * cos(alpha_0) * nu_2;
                l_dz * nu_1,                 l_dz * nu_2 ];
                
    % Protect against singularity (when motors are off and velocity is zero)
    if abs(det(M_flap)) &lt; 1e-6
        delta = [0; 0];
    else
        delta = M_flap \ [mx_d; my_d];
    end
end</P>
      </eml>
    </state>
    <data SSID="4" name="T_c">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="5" name="omega">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">[2 1]</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="6" name="m_c">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="7" name="v_alpha">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="8" name="delta">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">[2 1]</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <transition SSID="2">
      <P Name="labelString">{eML_blk_kernel();}</P>
      <P Name="labelPosition">[28.125 13.875 102.544 14.964]</P>
      <P Name="fontSize">12</P>
      <src>
        <P Name="intersection">[0 0 1 0 23.5747 14.625 0 0]</P>
      </src>
      <dst>
        <P Name="SSID">3</P>
        <P Name="intersection">[1 0 -1 0 23.5747 42.5747 0 0]</P>
      </dst>
