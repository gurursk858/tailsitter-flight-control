__MWOPC_PART_BEGIN__ /simulink/stateflow/chart_36.xml
<?xml version="1.0" encoding="utf-8"?>
<chart id="36">
  <P Name="name">Plant/MATLAB Function</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">36</P>
  <P Name="visible">1</P>
  <subviewS/>
  <P Name="ssIdHighWaterMark">14</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">2</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">P6dof</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">36</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [x_dot_world, v_dot_world, xi_dot, Omega_dot_body] = P6dof(F_net_body, M_net_body, v_world, xi, Omega_body)
    % plant_6dof_physics calculates the kinematic and dynamic derivatives
    % of the tailsitter drone. 
    
    % INPUTS:
    % F_net_body    : 3x1 vector (Aerodynamic + Thrust Forces in Body Frame)
    % M_net_body    : 3x1 vector (Aerodynamic + Thrust Moments in Body Frame)
    % v_world       : 3x1 vector (Current Velocity in World Frame)
    % Omega_body    : 3x1 vector (Current Angular Velocity in Body Frame)
    % xi            : 4x1 vector (Current Attitude Quaternion)
    
    % OUTPUTS:
    % x_dot_world   : 3x1 vector (Velocity to be integrated into Position)
    % v_dot_world   : 3x1 vector (Acceleration to be integrated into Velocity)
    % xi_dot        : 4x1 vector (Quat rate to be integrated into Attitude)
    % Omega_dot_body: 3x1 vector (Angular Accel to be integrated into Ang Vel)
    
    % --- HARDCODED CONSTANTS ---
    mass = 0.7; % kg
    g = 9.81;   % Gravity (m/s^2)
    
    % Inertia Tensor (kg*m^2)
    J_xx = 0.0216;
    J_yy = 0.0070;
    J_zz = 0.0282;
    J_xz = -0.0016; 
    
    J = [J_xx,    0, J_xz;
            0, J_yy,    0;
         J_xz,    0, J_zz];
         
    %J_inv = inv(J);
    % ---------------------------
    
    % Ensure quaternion is normalized before doing math
    xi = xi / norm(xi);
    q0 = xi(1); q1 = xi(2); q2 = xi(3); q3 = xi(4);
    
    % Convert Quaternion to Rotation Matrix (Body to World: R_b_i)
    % Standard ZYX to matching ZXY sequence matrix
    R_b_i = [q0^2 + q1^2 - q2^2 - q3^2,   2*(q1*q2 - q0*q3),        2*(q1*q3 + q0*q2);
             2*(q1*q2 + q0*q3),           q0^2 - q1^2 + q2^2 - q3^2, 2*(q2*q3 - q0*q1);
             2*(q1*q3 - q0*q2),           2*(q2*q3 + q0*q1),        q0^2 - q1^2 - q2^2 + q3^2];
             
    % ==========================================
    % 1. TRANSLATIONAL KINEMATICS &amp; DYNAMICS
    % ==========================================
    % Equation 1: Position derivative is just velocity
    x_dot_world = v_world;
    
    % Equation 2: Linear acceleration (Newton&apos;s Second Law)
    % Note: In NED (North-East-Down) convention, gravity points in positive Z
    gravity_world = [0; 0; mass * g];
    
    % Rotate body forces into the world frame, add gravity, divide by mass
    F_net_world = (R_b_i * F_net_body) + gravity_world;
    v_dot_world = F_net_world / mass;
    
    % ==========================================
    % 2. ROTATIONAL KINEMATICS &amp; DYNAMICS
    % ==========================================
    % Equation 4: Angular acceleration (Euler&apos;s Rotation Equation)
    % J * w_dot + w x (J * w) = M
    cross_term = cross(Omega_body, (J * Omega_body));
    Omega_dot_body = J\ (M_net_body - cross_term);
    
    % Equation 3: Quaternion derivative
    % xi_dot = 0.5 * xi (tensor) Omega
    p = Omega_body(1);
    q = Omega_body(2);
    r = Omega_body(3);
    
    % Manual expansion of quaternion kinematic matrix for C-code generation
    Q_matrix = [ 0, -p, -q, -r;
                 p,  0,  r, -q;
                 q, -r,  0,  p;
                 r,  q, -p,  0 ];
                 
    xi_dot = 0.5 * Q_matrix * xi;

end</P>
      </eml>
    </state>
    <data SSID="4" name="F_net_body">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="5" name="x_dot_world">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">[ 3 1]</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="6" name="M_net_body">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="7" name="v_world">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="13" name="xi">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="8" name="v_dot_world">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="9" name="xi_dot">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="12" name="Omega_body">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="14" name="Omega_dot_body">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <transition SSID="2">
      <P Name="labelString">{eML_blk_kernel();}</P>
      <P Name="labelPosition">[28.125 13.875 102.544 14.964]</P>
      <P Name="fontSize">12</P>
      <src>
        <P Name="intersection">[0 0 1 0 23.5747 14.625 0 0]</P>
      </src>
      <dst>
        <P Name="SSID">3</P>
        <P Name="intersection">[1 0 -1 0 23.5747 42.5747 0 0]</P>
      </dst>
      <P Name="midPoint">[23.5747 24.9468]</P>
