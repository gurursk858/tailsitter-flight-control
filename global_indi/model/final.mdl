__MWOPC_PART_BEGIN__ /simulink/stateflow/chart_21.xml
<?xml version="1.0" encoding="utf-8"?>
<chart id="21">
  <P Name="name">Controller_flight/MATLAB Function</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">21</P>
  <P Name="ssIdHighWaterMark">14</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">1</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">Flatness_Jerk_Transform</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">21</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function Omega_ref = Flatness_Jerk_Transform(theta_bar, phi, j_ref, v_i, psi_ref, delta, f_c_i, a_i, psi_dot_ref)
    % ---------------------------------------------------------------------
    % PARAMETERS (Matching previous blocks)
    % ---------------------------------------------------------------------
    mass       = 0.7;           % Vehicle mass [kg]
    alpha_0    = -2 * pi / 180; % Zero-lift angle 
    alpha_T    = -5 * pi / 180; % Thrust angle
    alpha_bar  = alpha_0 + alpha_T;
    
    c_DT       = 0;
    c_LT       = 2.23;
    c_LT_delta = 1.25;
    c_DV       = 0;
    c_LV       = 0.29;
    c_LV_delta = 0.18;
    delta_net = delta(1) + delta(2);
    % ---------------------------------------------------------------------
    % STEP 1: RECALCULATE BASE VARIABLES (To avoid passing 10 variables)
    % ---------------------------------------------------------------------
    % Yaw and Roll Rotation Matrices
    R_i_psi   = [ cos(psi_ref), sin(psi_ref), 0; 
                 -sin(psi_ref), cos(psi_ref), 0; 
                  0,            0,            1];
                  
    R_psi_phi = [ 1, 0,        0; 
                  0, cos(phi), sin(phi); 
                  0,-sin(phi), cos(phi)];
                  
    R_i_phi   = R_psi_phi * R_i_psi;
    
    % Vectors in phi frame
    f_phi = R_i_phi * f_c_i;
    v_phi = R_i_phi * v_i;
    
    % Eta (Eq. 23)
    eta = (sin(alpha_bar)*(c_LT-1) - cos(alpha_bar)*c_LT_delta*(delta_net/2)) / (cos(alpha_bar)*(1-c_DT));
    
    % Sigma Base Arguments (Eq. 21)
    v_norm = norm(v_i);
    sigma_x = eta*(f_phi(1) + c_DV*v_norm*v_phi(1)) - c_LV_delta*delta_net*v_norm*v_phi(1) - c_LV*v_norm*v_phi(3) - f_phi(3);
    sigma_z = eta*(f_phi(3) + c_DV*v_norm*v_phi(3)) - c_LV_delta*delta_net*v_norm*v_phi(3) + c_LV*v_norm*v_phi(1) + f_phi(1);

    % ---------------------------------------------------------------------
    % STEP 2: FORCE DERIVATIVE &amp; ROLL RATE (Eq. 24, 25, 26, 27)
    % ---------------------------------------------------------------------
    f_dot_i = mass * j_ref; % Eq. 27
    
    beta_x = -sin(psi_ref)*f_c_i(1) + cos(psi_ref)*f_c_i(2);
    beta_z = f_c_i(3);
    
    % Eq. 25 &amp; 26
    beta_x_dot = -cos(psi_ref)*psi_dot_ref*f_c_i(1) - sin(psi_ref)*f_dot_i(1) ...
                 -sin(psi_ref)*psi_dot_ref*f_c_i(2) + cos(psi_ref)*f_dot_i(2);
    beta_z_dot = f_dot_i(3);
    
    % Eq. 24 (Protected against singularity)
    phi_dot = -(beta_x_dot * beta_z - beta_x * beta_z_dot) / (beta_x^2 + beta_z^2 + 1e-6);

    % ---------------------------------------------------------------------
    % STEP 3: FRAME KINEMATICS (Eq. 33, 34)
    % ---------------------------------------------------------------------
    % Angular velocity of the phi-frame relative to world, expressed in phi-frame
    omega_phi_frame = [phi_dot; 0; 0] + R_psi_phi * [0; 0; psi_dot_ref];
    
    % Derivative of rotated vectors using cross-product kinematics
    v_phi_dot = R_i_phi * a_i     - cross(omega_phi_frame, v_phi);
    f_phi_dot = R_i_phi * f_dot_i - cross(omega_phi_frame, f_phi);
    
    % Eq. 33 (Protected against hover singularity where v_norm = 0)
    if v_norm &lt; 1e-4
        v_norm_dot = 0;
    else
        v_norm_dot = dot(v_i, a_i) / v_norm;
    end

    % ---------------------------------------------------------------------
    % STEP 4: VELOCITY MAGNITUDE TERMS (Eq. 31, 32)
    % ---------------------------------------------------------------------
    tau_x = v_norm_dot * v_phi(1) + v_norm * v_phi_dot(1);
    tau_z = v_norm_dot * v_phi(3) + v_norm * v_phi_dot(3);

    % ---------------------------------------------------------------------
    % STEP 5: PITCH RATE DERIVATIVE (Eq. 28, 29, 30)
    % ---------------------------------------------------------------------
    sigma_x_dot = eta*(f_phi_dot(1) + c_DV*tau_x) - c_LV_delta*delta_net*tau_x - c_LV*tau_z - f_phi_dot(3);
    sigma_z_dot = eta*(f_phi_dot(3) + c_DV*tau_z) - c_LV_delta*delta_net*tau_z + c_LV*tau_x + f_phi_dot(1);
    
    % Eq. 28 (Protected against singularity)
    theta_bar_dot = (sigma_x_dot * sigma_z - sigma_x * sigma_z_dot) / (sigma_x^2 + sigma_z^2 + 1e-6);
    
    % True pitch rate is identical to theta_bar_dot because alpha_0 is constant
    theta_dot = theta_bar_dot;

    % ---------------------------------------------------------------------
    % STEP 6: ANGULAR VELOCITY ASSEMBLY (Eq. 35)
    % ---------------------------------------------------------------------
    theta = theta_bar + alpha_0;
    
    % Rotation matrix from phi frame to body frame (Pitch)
    R_phi_b = [ cos(theta), 0, -sin(theta); 
                0,          1,  0; 
                sin(theta), 0,  cos(theta) ];
                
    % Rotation matrix from yaw frame to body frame
    R_psi_b = R_phi_b * R_psi_phi;
    
    % Final Feedforward Angular Velocity (Mapped fully into body frame)
    Omega_ref = [0; theta_dot; 0] + R_phi_b * [phi_dot; 0; 0] + R_psi_b * [0; 0; psi_dot_ref];
end</P>
      </eml>
    </state>
    <data SSID="14" name="theta_bar">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="13" name="phi">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="11" name="Omega_ref">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="4" name="j_ref">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="7" name="v_i">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="9" name="psi_ref">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="12" name="delta">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="6" name="f_c_i">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="8" name="a_i">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="10" name="psi_dot_ref">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
